#!/usr/bin/env ys-0

use: ipc fs

defn main(mode=nil):
  if mode == '--skipped':
    show-skipped:
    else:
      show-missing:
      show-by-hand:
      show-versions:

missing =::
- bison
- cursor
- flex
- fpc
- freebasic
- gcc
- gnat
- graalvm
- lein
- ocaml
- processing
- raku

defn show-missing():
  say: 'Check support missing:'
  each name missing:
    url =: read("$name.mk") =~ /https:\/\/\S+/
    say: format("* %-10s - %s" "$name.mk" url)

version-re =: '[A-Z][A-Z0-9-]*-VERSION\s\?=\s(\d+\..*)\n'
github-re =: '(?s:.*)(https://(www\.)?github\.com/[-\w]+/[-\w]+)\n'
parse-re =: qr(version-re + github-re)
version-file-re =: /(?m)^[A-Z][A-Z0-9-]*-VERSION\s+\?=/
current-version-re =:
  /(?m)^[A-Z][A-Z0-9-]*-VERSION\s+\?=\s+(\S+)/
tag-re =: +
  '^(Cabal-v|pandoc-cli-|bun-v|[a-z]+-?)?' +
  '[0-9]+\.[0-9]+\.[0-9]+(\.[0-9]+)?$'

files =: fs/glob('*.mk'):sort

defn show-skipped():
  say: 'Version updates skipped:'
  skipped =: skipped-files()
  name-width =: max(skipped.map(count)*)
  version-width =:
    max(skipped.map(\(current-version(_).#))*)
  pattern =: +
    '%-' + name-width:S + 's  %-' +
    version-width:S + 's  %s'
  each file skipped:
    version =: current-version(file)
    url =: file:read =~ /https:\/\/\S+/
    if url:
      say: format(pattern file version url)
      say: format(pattern file version '')

defn current-version(file):
  version =: file:read.re-find(current-version-re).1
  if version.starts?('$('):
    then: 'dynamic'
    else:
      if version =~ /^\d/:
        then: "v$version"
        else: version

defn skipped-files():
  automatic =: automatic-files()
  skipped =: version-files()
  skipped: .remove(\(_.in?(automatic)))

defn version-files():
  files.filter(\(_:read.re-find(version-file-re)))

defn automatic-files():
  conj github-files(): 'java.mk'

defn github-files():
  files: .remove(\(_:read.re-find(/www\.github/)))
    .remove(\(_.replace(/\.mk/).in?(missing)))
    .filter(\(_:read.re-find(parse-re)))

defn show-versions():
  say:
  say: 'Checking current versions:'
  show-java-version:

  files =:
    reduce _ [] github-files():
      fn(files file):
        _ ver url =:
          file:read =~ parse-re
        if ver:
          then:
            phrase =:
              format "* %-13s - %s": file url
            say: phrase
            new =: ipc/shell(url:cmd).out:lines:highest
            if new:
              if new != ver:
                conj files: +[file ver new url]
                else: files
              else: files
          else: files

  each file files:
    say: format('%-20s  %-10s -> %-10s  %s/tags' file*)

# Oracle's download headings contain the full GA version, unlike the
# moving major-only download URLs. Do not use OpenJDK tags or EA builds.
defn show-java-version():
  url =: 'https://www.oracle.com/java/technologies/downloads/'
  say: format('* %-13s - %s' 'java.mk' url)
  page =: ipc/sh-out('curl' '-fsSL' '--max-time' '60' url)
  versions =:
    re-seq: /Java SE Development Kit\s+(\d+(?:\.\d+)*)\s+downloads/ page
  new =: versions.map(\(_.1)).sort-by(version-key).last()
  when-not new:
    die: 'Could not find an Oracle JDK release version'
  old =: read('java.mk').re-find(current-version-re).1
  when compare(version-key(new) version-key(old)) > 0:
    major =: new.split(/\./).0
    channel =:
      if new =~ /\./: +
        'archive'
        'latest'
    archive =: "https://download.oracle.com/java/$major/$channel/"
    archive +=: +"jdk-" + new + '_linux-x64_bin.tar.gz'
    ipc/sh-out 'curl' '-fsIL' '--max-time' '60': archive
    say: format('%-20s  %-10s -> %-10s  %s' 'java.mk' old new url)

defn version-key(version):
  version.split(/\./).map(\(format('%010d' _:I))).join('.')

defn show-by-hand():
  files =: files
    .filter(\(_:read.re-find(qr("https://www\.github\.com/.*"))))
    .map(\([_
            _:read.re-find(parse-re).1
            _:read.re-find(qr("https://www\.github\.com/.*"))]))

  say: "\nCheck these by hand:"
  each file files:
    say: format("* %-10s - %-11s - %s" file*)

defn cmd(url): |
  git ls-remote \
      --tags \
      $url | \
    cut -d/ -f3 | \
    grep -E '$tag-re' | \
    sed -E 's/^(Cabal-v|pandoc-cli-|bun-v|OTP-|[a-z]+-?)//; s/\.ROLLING$//' | \
    sort -V

defn highest(list):
  list.filter(\(_)).$
